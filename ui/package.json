{
  "name": "skylarks-bsm-relay",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "extract": "dotenvx run -- wuchale",
    "clean": "dotenvx run -- wuchale --clean",
    "preview": "vite preview",
    "test": "dotenvx run -- vitest && pnpm test:e2e",
    "sv-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "generate:types": "typed-pocketbase -d src/lib/model",
    "test:e2e": "dotenvx run -- playwright test",
    "test:ui": "dotenvx run -- playwright test --ui",
    "test:unit": "dotenvx run -- vitest"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.75.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@vincjo/datatables": "^2.8.1",
    "@wuchale/svelte": "^0.19.4",
    "berlin-skylarks-theme": "^1.0.0",
    "bits-ui": "^2.20.4",
    "bsm.js": "^0.4.0",
    "chart.js": "^4.6.1",
    "lucide-svelte": "^1.0.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-persisted-state": "^1.4.1",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wuchale": "^0.23.4"
  },
  "type": "module"
}
